# Hermes Agent API Key（用于调用 LLM 分析服务）
HERMES_API_KEY=your_hermes_api_key_here
HERMES_API_URL=https://api.hermes.example.com/v1/chat/completions

# 服务配置
HOST=0.0.0.0
PORT=8000
# AI 咨询带上的历史轮数上限，-1 表示带上全部历史
CHAT_HISTORY_TURN_LIMIT=10

# 允许跨域的前端地址（多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,tauri://localhost

# API 鉴权密钥（客户端需携带此 key 才能访问）
API_SECRET_KEY=your_client_secret_key_here
